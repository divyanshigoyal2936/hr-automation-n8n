      "main": [
        [
          {
            "node": "Split In Batches (1 at a time)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split In Batches (1 at a time)": {
      "main": [
        [
          {
            "node": "Fetch Job Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Job Details": {
      "main": [
        [
          {
            "node": "AI Candidate Evaluation (OpenAI)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Candidate Evaluation (OpenAI)": {
      "main": [
